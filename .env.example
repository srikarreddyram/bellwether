# Bellwether configuration.
# Copy to .env and adjust. Every value below is the default; nothing here is
# required to run locally. `bellwether config` prints the effective settings
# with secrets redacted.

# ── Runtime state ─────────────────────────────────────────────────────────────
# Everything the platform writes lives under one directory: traffic weight,
# telemetry, per-instance virtualenvs, logs, pid files and the SQLite history.
# BELLWETHER_STATE_DIR=/tmp/bellwether
# BELLWETHER_DATABASE=/tmp/bellwether/deployments.db

# ── Control plane (API + websocket) ───────────────────────────────────────────
# BELLWETHER_API_HOST=127.0.0.1
# BELLWETHER_API_PORT=5001
#
# Dashboard origins. A wildcard is REFUSED at startup: /api/deploy executes code
# named in the request body, so `*` would let any page you visit trigger a
# deployment.
# BELLWETHER_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
#
# Required to bind anywhere other than loopback. Startup fails without it.
# BELLWETHER_API_TOKEN=
#
# GitHub webhook HMAC secret. The webhook fails closed while this is unset.
# BELLWETHER_WEBHOOK_SECRET=

# ── Data plane (traffic proxy) ────────────────────────────────────────────────
# BELLWETHER_PROXY_HOST=127.0.0.1
# BELLWETHER_PROXY_PORT=9000
# BELLWETHER_STABLE_PORT=8001
# BELLWETHER_CANARY_PORT=8002
# BELLWETHER_UPSTREAM_TIMEOUT_S=10
#
# Pin a client to one cohort for the cookie's lifetime, so a single user does
# not flip between versions mid-session.
# BELLWETHER_STICKY_SESSIONS=1
# BELLWETHER_COHORT_TTL_S=600
#
# Telemetry ring buffer, and how often it is flushed to disk. Flushing is
# coalesced rather than per-request to keep proxy overhead low.
# BELLWETHER_TELEMETRY_WINDOW=500
# BELLWETHER_TELEMETRY_FLUSH_S=0.25

# ── Risk gate ─────────────────────────────────────────────────────────────────
# BELLWETHER_LATENCY_P95_THRESHOLD_MS=500
# BELLWETHER_ERROR_RATE_THRESHOLD=0.05
# BELLWETHER_MIN_CANARY_SAMPLES=5
# BELLWETHER_MAX_TELEMETRY_AGE_S=120
#
# What to do when there is not enough canary traffic to judge the build:
#   abort    fail closed. The default: never promote on absent evidence.
#   simulate synthesise metrics. Demos only; the verdict is labelled SIMULATED.
#   promote  fail open. Only where the gate is explicitly advisory.
# BELLWETHER_INSUFFICIENT_DATA_POLICY=abort

# ── Audit trail (MLflow, optional) ────────────────────────────────────────────
# BELLWETHER_TRACKING_ENABLED=1
# MLFLOW_TRACKING_URI=sqlite:///$BELLWETHER_STATE_DIR/mlflow.db
# BELLWETHER_MLFLOW_EXPERIMENT=bellwether-canary
# BELLWETHER_MLFLOW_RETENTION_RUNS=50

# ── Rollout behaviour ─────────────────────────────────────────────────────────
# BELLWETHER_ALLOWED_REPO_HOSTS=github.com,gitlab.com,bitbucket.org
# BELLWETHER_CLONE_DEPTH=1
# BELLWETHER_LAUNCH_TIMEOUT_S=90
# BELLWETHER_CANARY_SOAK_S=20
# BELLWETHER_PROMOTE_SOAK_S=10
# BELLWETHER_LOAD_WORKERS=8
#
# Accept a local directory as a repository. Development and tests only -- never
# enable this on a network-reachable deployment.
# BELLWETHER_ALLOW_LOCAL_REPOS=0

# ── Fault injection ───────────────────────────────────────────────────────────
# Deliberately degrade the CANARY ONLY, to rehearse a rollback. Stable is never
# perturbed, or the baseline comparison would be meaningless.
# BELLWETHER_ENABLE_CHAOS=0
# BELLWETHER_CHAOS_ERROR_RATE=0.15

# ── Logging ───────────────────────────────────────────────────────────────────
# BELLWETHER_LOG_LEVEL=INFO
# BELLWETHER_LOG_FORMAT=text   # or: json
